              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Status Code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Limit equals 50\", function () {",
                  "    pm.expect(json.limit).to.equal(50);",
                  "});",
                  "",
                  "pm.test(\"Products exist\", function () {",
                  "    pm.expect(json).to.have.property(\"products\");",
                  "});",
                  "",
                  "pm.test(\"Products is an array\", function () {",
                  "    pm.expect(json.products).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Products count is 50\", function () {",
                  "    pm.expect(json.products).to.have.lengthOf(50);",
                  "});",
                  "",
                  "pm.test(\"Every product has id\", function () {",
                  "    json.products.forEach(function(product) {",
                  "        pm.expect(product).to.have.property(\"id\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Every product has valid name\", function () {",
                  "    json.products.forEach(function(product) {",
                  "        pm.expect(product).to.have.property(\"name\");",
                  "        pm.expect(product.name).to.be.a(\"string\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Every product has price greater than 0\", function () {",
                  "    json.products.forEach(function(product) {",
                  "        pm.expect(product.price).to.be.above(0);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Every product available is boolean\", function () {",
                  "    json.products.forEach(function(product) {",
                  "        pm.expect(product.available).to.be.a(\"boolean\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
