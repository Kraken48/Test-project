{
  "info": {
    "name": "Shop API — QA Portfolio",
    "_postman_id": "0b8d2d5a-6a36-4d3c-9d1b-qa0000000001",
    "description": "Portfolio demo collection for API testing with Postman. Uses a placeholder base URL and fictional test data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.example.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Authorization",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@mail.com\",\n  \"password\": \"12345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Status Code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Success is true\", function () {",
                  "    pm.expect(json.success).to.equal(true);",
                  "});",
                  "",
                  "pm.test(\"Token exists\", function () {",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "});",
                  "",
                  "pm.environment.set(\"token\", json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "profile"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Status Code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"ID exists\", function () {",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "});",
                  "",
                  "pm.test(\"Name is string\", function () {",
                  "    pm.expect(json.name).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"Email is correct\", function () {",
                  "    pm.expect(json.email).to.equal(\"test@mail.com\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
